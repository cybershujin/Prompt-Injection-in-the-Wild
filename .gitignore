# The public repo tracks the tracker + generator + workflow, PLUS the monthly
# sweep skill (so the cloud routine that clones this repo can run it).

# Local Claude config is ignored EXCEPT the sweep skill directory.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/update-prompt-injection-tracker/
.claude/skills/update-prompt-injection-tracker/__pycache__/

# Never commit the local MCP config (it references the Perplexity API key env var)
.mcp.json

# Perplexity sweep intermediates and drafts
candidates*.json
proposed-update-*.md
date-backfill-audit-*.md
candidates-*.md

# Python
__pycache__/
*.pyc

# OS / editor
.DS_Store
Thumbs.db
*.swp
